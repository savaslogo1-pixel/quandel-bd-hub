# SQLite for local development. For shared use, switch prisma/schema.prisma to
# provider = "postgresql" and point this at the Postgres database.
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Microsoft 365 / Entra ID sign-in (app registration from Quandel IT)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Only allow sign-in from this email domain, e.g. the Quandel domain [confirm]
ALLOWED_EMAIL_DOMAIN=""

# Local development only: sign in with any email, no password. Never in production.
DEV_LOGIN="true"
