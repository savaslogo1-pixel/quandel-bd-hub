// Quandel BD Hub — Phase 1 schema
// Scope: users and roles, company tags, picklists, Organizations, Contacts, Activities.
// SQLite for local development; the same schema moves to Postgres for shared use
// (change `provider` and DATABASE_URL). SQLite has no scalar lists, so tag sets are
// relations and multi-value picks are join tables.
//
// Every business table carries id, createdAt, updatedAt and createdBy (SPEC §4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Users, roles, companies ─────────────────────────

/// SPEC §1. ADMIN manages users, picklists and imports.
enum Role {
  ADMIN
  BD_DIRECTOR // BD director / Enterprise BD: sees every company's pipeline
  BD_LEAD
  LEADERSHIP // company president / leadership
  ESTIMATOR // estimator / preconstruction
  QES_DEVELOPER
  COMPLIANCE
  TRAINEE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique // Quandel M365 address
  name      String?
  image     String?
  role      Role     @default(TRAINEE)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Companies this person works for or covers (drives default pipeline views)
  companies Company[] @relation("UserCompanies")

  ownedOrganizations Organization[] @relation("OrgRelationshipOwner")

  createdOrganizations Organization[]             @relation("OrgCreatedBy")
  createdContacts      Contact[]                  @relation("ContactCreatedBy")
  createdActivities    Activity[]                 @relation("ActivityCreatedBy")
  createdOpportunities Opportunity[]              @relation("OppCreatedBy")
  ownedOpportunities   Opportunity[]              @relation("OppOwner")
  goNoGoApprovals      Opportunity[]              @relation("OppGoNoGoApprover")
  procIndependenceLogs Opportunity[]              @relation("OppProcIndependenceBy")
  disclosureLogs       Opportunity[]              @relation("OppDisclosureBy")
  checklistTicks       OpportunityChecklistItem[]
  stageChanges         OpportunityStageChange[]
  verifiedPrograms     FundingProgram[]           @relation("ProgramVerifiedBy")
  createdPrograms      FundingProgram[]           @relation("ProgramCreatedBy")
  createdStackRows     CapitalStackRow[]
  notifications        Notification[]
  verifiedRules        StateRule[]                @relation("RuleVerifiedBy")
  createdApprovalSteps ApprovalStep[]

  // NextAuth (Microsoft 365 sign-in)
  accounts Account[]
  sessions Session[]
}

/// SPEC §2. QCG, QES, PCS, JVS, PYR, ENT. Seeded; editable by admins.
model Company {
  id               String   @id @default(cuid())
  code             String   @unique // QCG | QES | PCS | JVS | PYR | ENT
  name             String
  base             String? // "[confirm]" where unknown (PYR)
  sells            String?
  buyers           String?
  procurementPaths String?
  isParent         Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                User[]         @relation("UserCompanies")
  organizations        Organization[] @relation("OrgCompanies")
  activities           Activity[]     @relation("ActivityCompanies")
  leadOpportunities    Opportunity[]  @relation("OppLead")
  supportOpportunities Opportunity[]  @relation("OppSupport")
}

/// Admin-editable picklists (SPEC §6 Admin). Lists used in Phase 1:
///   org_type, contact_function, activity_type, preferred_channel
model PicklistValue {
  id        String   @id @default(cuid())
  list      String
  value     String // stored on records, e.g. "school district"
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([list, value])
  @@index([list, active, sortOrder])
}

// ───────────────────────── Organizations (SPEC §4.1) ─────────────────────────

/// SPEC §3. New states are added here when their training edition is built.
enum StateCode {
  PA
  NY
  MD
  NJ
  DE
  OH
  WV
  VA
  DC
}

enum Tier {
  A
  B
  C
}

enum OrgStatus {
  TARGET
  ACTIVE
  CLIENT
  DORMANT
  DO_NOT_PURSUE
}

model Organization {
  id      String    @id @default(cuid())
  name    String
  orgType String // PicklistValue(list = "org_type").value
  state   StateCode
  county  String?
  region  String? // PA region, NY REDC region, MD county grouping
  address String?
  website String?

  parentOrgId String? // e.g., a school's IU or BOCES
  parentOrg   Organization?  @relation("OrgParent", fields: [parentOrgId], references: [id], onDelete: SetNull)
  childOrgs   Organization[] @relation("OrgParent")

  // Geography flags (SPEC §3)
  arcCounty              Boolean @default(false)
  energyCommunity        Boolean @default(false)
  opportunityZoneTract   Boolean @default(false)
  disadvantagedCommunity Boolean @default(false) // NY
  fiscalStressStatus     String? // NY FSMS designation or PA Act 47 status

  // Public-owner profile
  population            Int?
  enrollment            Int?
  annualBudget          Decimal?
  fiscalYearStart       String? // e.g., "July 1"
  debtOutstanding       Decimal?
  debtLimit             Decimal?
  recentBondIssues      String?
  creditRating          String?
  taxCapOverrideHistory String? // NY

  // Facilities profile
  buildingCount               Int?
  oldestBuildingYear          Int?
  lastMajorRenovationYear     Int?
  lastEnergyProjectYear       Int?
  lastEnergyProjectEsco       String?
  capitalPlanUrl              String?
  capitalPlanDate             DateTime?
  buildingConditionSurveyDate DateTime? // NY schools

  // Governance — the meeting pattern feeds the backward scheduler in Phase 4
  governingBody        String? // e.g., "Board of School Directors"
  meetingWeekday       Int? // 0 = Sunday … 6 = Saturday
  meetingWeeksOfMonth  String? // comma list: "2,4"; 5 = last week
  meetingPatternNote   String? // free text when irregular
  agendaDeadlineDays   Int? // days before a meeting the agenda closes
  voteRules            String? // e.g., "two-thirds for bonds"
  permissiveReferendum Boolean @default(false)

  relationshipOwnerId String?
  relationshipOwner   User?     @relation("OrgRelationshipOwner", fields: [relationshipOwnerId], references: [id], onDelete: SetNull)
  companies           Company[] @relation("OrgCompanies") // company tags
  tier                Tier?
  status              OrgStatus @default(TARGET)
  source              String? // e.g., "GESA eligible owners workbook"

  contacts      Contact[]
  activities    Activity[]
  opportunities Opportunity[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("OrgCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // De-duplication key for imports (SPEC §8): name + state + type
  @@unique([name, state, orgType])
  @@index([state, orgType])
  @@index([tier, status])
  @@index([relationshipOwnerId])
}

// ───────────────────────── Contacts (SPEC §4.2, §4.3) ─────────────────────────

enum DecisionRole {
  DECIDER
  ADVISOR
  INFLUENCER
  GATEKEEPER
  USER
}

model Contact {
  id          String       @id @default(cuid())
  name        String
  title       String?
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String?
  phone       String?
  linkedinUrl String?

  decisionRole         DecisionRole?
  function             String? // PicklistValue(list = "contact_function").value
  relationshipStrength Int? // 1–5
  lastTouch            DateTime?
  nextTouch            DateTime?
  preferredChannel     String? // PicklistValue(list = "preferred_channel").value
  optOut               Boolean       @default(false) // opted out of email
  doNotContact         Boolean       @default(false)

  // Decision map: who influences whom (SPEC §4.3)
  influences   Contact[] @relation("ContactInfluence")
  influencedBy Contact[] @relation("ContactInfluence")

  activities        Activity[] @relation("ActivityContacts")
  advisedActivities Activity[] @relation("ActivityFinancialAdvisor")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   String?
  createdBy     User?          @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvalSteps ApprovalStep[]

  @@index([orgId])
  @@index([nextTouch])
}

// ───────────────────────── Activities (SPEC §4.9, §4.14) ─────────────────────────

model Activity {
  id         String       @id @default(cuid())
  type       String // PicklistValue(list = "activity_type").value
  occurredAt DateTime
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contacts   Contact[]    @relation("ActivityContacts")
  companies  Company[]    @relation("ActivityCompanies") // company tags

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  notes        String?
  nextStep     String?
  nextStepDate DateTime?
  nextStepDone Boolean   @default(false)

  // Board-meeting log (type = "board meeting attended")
  agendaItems String?
  votesTaken  String?
  minutesUrl  String?

  // Municipal-advisor flag: if financing was discussed, the owner's financial
  // advisor must be linked. Enforced in the app; open flags show in Compliance.
  financingDiscussed        Boolean  @default(false)
  financialAdvisorContactId String?
  financialAdvisorContact   Contact? @relation("ActivityFinancialAdvisor", fields: [financialAdvisorContactId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, occurredAt])
  @@index([nextStepDate])
  @@index([createdById])
  @@index([opportunityId])
}

// ───────────────────────── Opportunities (SPEC §4.4, §5, §9) — Phase 2 ─────────────────────────

/// SPEC §4.4 delivery methods. Checklists per method live in data/pipeline.json.
enum DeliveryMethod {
  MULTIPLE_PRIME_BID // PA Separations Act / NY Wicks
  SINGLE_PRIME_BID
  CM_AGENCY
  CM_AT_RISK // GMP
  DESIGN_BUILD
  GESA_EPC
  HUD_EPC
  P3_BUNDLE
  COOPERATIVE // COSTARS, etc.
  NEGOTIATED_PRIVATE
}

enum GoNoGo {
  GO
  NO_GO
  PENDING
}

enum Outcome {
  WON
  LOST
  NO_BID
}

/// SPEC §9: the owner's decision after the related-company disclosure.
enum DisclosureDecision {
  ONE_TEAM_ACCEPTED
  SEPARATE_PROCUREMENT_REQUIRED
  PENDING
}

model Opportunity {
  id    String       @id @default(cuid())
  name  String
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Company tags: one lead company plus support companies (a joint pursuit when any support)
  leadCompanyId    String
  leadCompany      Company   @relation("OppLead", fields: [leadCompanyId], references: [id])
  supportCompanies Company[] @relation("OppSupport")

  projectType    String? // PicklistValue(list = "project_type").value
  deliveryMethod DeliveryMethod?
  /// Energy project that also needs roof, ADA or other non-energy work (routing: QES + QCG)
  nonEnergyScope Boolean         @default(false)

  estimatedValue    Decimal?
  quandelScopeValue Decimal?
  probability       Int? // 0–100; weighted value = (scope or estimated) × probability, computed

  ownerId String? // pursuit owner
  owner   User?   @relation("OppOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  stage          Int      @default(1) // 1–10, see data/pipeline.json
  stageEnteredAt DateTime @default(now())

  goNoGo           GoNoGo?
  goNoGoReason     String?
  goNoGoAt         DateTime?
  goNoGoApproverId String?
  goNoGoApprover   User?     @relation("OppGoNoGoApprover", fields: [goNoGoApproverId], references: [id], onDelete: SetNull)

  outcome    Outcome?
  lossReason String? // required for Lost / No-bid

  // Key dates
  rfqIssueDate              DateTime?
  preBidDate                DateTime?
  dueDate                   DateTime?
  interviewDate             DateTime?
  boardVoteDate             DateTime?
  awardDate                 DateTime?
  constructionStartDate     DateTime?
  substantialCompletionDate DateTime?

  competitors String? // free text until the Competitors table (Phase 7)
  winThemes   String?

  // Compliance (SPEC §4.14, §9) — required, not optional
  /// "Did we help write specs or scoring?" null = not answered; must be false to pursue
  helpedWriteSpecs     Boolean?
  procIndependenceAt   DateTime? // QES did not write the owner's GESA/EPC RFP or scoring (stage 5)
  procIndependenceById String?
  procIndependenceBy   User?               @relation("OppProcIndependenceBy", fields: [procIndependenceById], references: [id], onDelete: SetNull)
  disclosureDecision   DisclosureDecision? // QES + construction company on one owner
  disclosureNote       String?
  disclosureAt         DateTime?
  disclosureById       String?
  disclosureBy         User?               @relation("OppDisclosureBy", fields: [disclosureById], references: [id], onDelete: SetNull)
  aeNoConflictCertAt   DateTime? // NY schools: A/E of record no-conflict certification (8 NYCRR § 155.20)

  checklist     OpportunityChecklistItem[]
  stageChanges  OpportunityStageChange[]
  activities    Activity[]
  stackRows     CapitalStackRow[]
  approvalSteps ApprovalStep[]

  /// Approvals timeline (Phase 4): the date the last step must meet, and the template used
  approvalsDeadline   DateTime?
  approvalsBufferDays Int?
  approvalsTemplate   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("OppCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([stage])
  @@index([orgId])
  @@index([leadCompanyId])
  @@index([ownerId])
}

/// A ticked item on the delivery-method checklist (items defined in data/pipeline.json).
model OpportunityChecklistItem {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  itemKey       String
  doneAt        DateTime    @default(now())
  doneById      String?
  doneBy        User?       @relation(fields: [doneById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([opportunityId, itemKey])
}

/// Stage history: every move, who made it, when.
model OpportunityStageChange {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     Int?
  toStage       Int
  note          String?
  changedById   String?
  changedBy     User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([opportunityId, createdAt])
}

// ───────────────────────── Funding programs and capital stacks (SPEC §4.5, §4.6) — Phase 3 ─────────────────────────

enum ProgramType {
  GRANT
  LOAN
  TAX_CREDIT
  FORMULA_AID
  REBATE
  ELECTIVE_PAY
}

/// What a program's match percentage is measured against.
enum MatchBasis {
  PROJECT_COST // match ≥ pct × total project cost
  AWARD // match ≥ pct × this program's award
}

/// One record per program, by state (or Federal). Seeded from data/programs.json; edited in the app.
model FundingProgram {
  id                 String       @id @default(cuid())
  key                String       @unique // stable seed key, e.g. "pa-racp"
  name               String
  agency             String?
  jurisdiction       String // state code or "Federal"
  programType        ProgramType?
  eligibleApplicants String? // free text list
  eligibleUses       String?
  minAward           Decimal?
  maxAward           Decimal?
  matchPct           Decimal? // e.g. 50 for 50%
  matchBasis         MatchBasis?
  matchType          String? // cash, in-kind, non-state funds…
  reimbursement      Boolean? // pays after the owner spends
  cycle              String? // rolling | annual | other
  nextDeadline       DateTime?
  url                String?
  notes              String?
  source             String? // where the details came from
  lastVerifiedAt     DateTime?
  lastVerifiedById   String?
  lastVerifiedBy     User?        @relation("ProgramVerifiedBy", fields: [lastVerifiedById], references: [id], onDelete: SetNull)

  stackRows CapitalStackRow[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("ProgramCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([jurisdiction])
  @@index([nextDeadline])
}

enum StackStatus {
  IDEA
  APPLIED
  AWARDED
  DENIED
  CLOSED
}

enum OtherSource {
  BOND
  NOTE
  CAPITAL_RESERVE
  GESA_FINANCING
  PRIVATE_EQUITY
  OWNER_CASH
  OTHER
}

/// A source in an opportunity's capital stack: a library program or another source.
model CapitalStackRow {
  id                   String          @id @default(cuid())
  opportunityId        String
  opportunity          Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  programId            String?
  program              FundingProgram? @relation(fields: [programId], references: [id], onDelete: Restrict)
  otherSource          OtherSource? // set when programId is empty
  label                String? // e.g. "2027 GO bond"
  amount               Decimal?
  status               StackStatus     @default(IDEA)
  applicationDate      DateTime?
  awardDate            DateTime?
  reimbursementLagDays Int?
  notes                String?
  sortOrder            Int             @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([opportunityId, sortOrder])
  @@index([programId])
}

/// In-app notifications (deadline alerts). `key` makes each alert fire once per person.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // e.g. "deadline:<programId>:<deadline>:<opportunityId>:30"
  kind      String // "deadline"
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId, readAt])
}

// ───────────────────────── State rules and approvals (SPEC §4.7, §7) — Phase 4 ─────────────────────────

/// A state-specific rule stored as data (seeded from data/state_rules.json; edited in the app).
/// The app reads rules by `key`; never hard-code a threshold.
model StateRule {
  id               String    @id @default(cuid())
  key              String    @unique // e.g. "NY.permissive_referendum_days"
  jurisdiction     String // state code, "Federal" or "HUD"
  topic            String // Bidding, Meetings, Debt, Energy, Records, Ethics, Lobbying, Procurement…
  text             String
  value            Decimal? // null = [confirm]
  unit             String?
  source           String?
  lastVerifiedAt   DateTime?
  lastVerifiedById String?
  lastVerifiedBy   User?     @relation("RuleVerifiedBy", fields: [lastVerifiedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?

  @@index([jurisdiction, topic])
}

enum ApprovalDocument {
  RESOLUTION
  CONSISTENCY_LETTER
  SUPPORT_LETTER
  SEQR_DETERMINATION
  BOND_ORDINANCE_RESOLUTION
  MOU_IMA
  CONTRACT_AWARD
  OTHER
}

enum ApprovalStatus {
  PLANNED
  SCHEDULED
  DONE
}

/// One step on an opportunity's approvals timeline (SPEC §4.7).
model ApprovalStep {
  id             String           @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sortOrder      Int
  label          String
  body           String? // who acts: governing body, planning commission, legislators…
  document       ApprovalDocument @default(OTHER)
  needsMeeting   Boolean          @default(false) // lands on the owner's board meeting calendar
  /// Days that must pass after this step before the next one (e.g. a referendum period)
  waitAfterDays  Int?
  /// When set, waitAfterDays is read from this StateRule at scheduling time
  waitRuleKey    String?
  meetingDate    DateTime? // the step's date (a board meeting when needsMeeting)
  agendaDeadline DateTime?
  dateSetBy      String? // "scheduler" or "manual"
  ownerContactId String?
  ownerContact   Contact?         @relation(fields: [ownerContactId], references: [id], onDelete: SetNull)
  status         ApprovalStatus   @default(PLANNED)
  notes          String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([opportunityId, sortOrder])
  @@index([meetingDate])
}

// ───────────────────────── NextAuth (Microsoft 365 sign-in) ─────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  ext_expires_in    Int? // returned by Microsoft Entra ID

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
